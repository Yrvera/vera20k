{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vera20k://system-map/mechanisms.v1",
  "title": "VERA20k System Map mechanism blocks v1",
  "type": "object",
  "required": [
    "schema_version",
    "observed_at_commit",
    "id_policy",
    "blocks",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observed_at_commit": {
      "$ref": "#/$defs/commit"
    },
    "id_policy": {
      "type": "object",
      "required": [
        "block_pattern",
        "edge_pattern",
        "rule"
      ],
      "properties": {
        "block_pattern": {
          "const": "^MBLK-[0-9]{3}-[A-Z0-9-]+$"
        },
        "edge_pattern": {
          "const": "^MBEDGE-[0-9]{4}-[A-Z0-9-]+$"
        },
        "rule": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "blocks": {
      "type": "object",
      "patternProperties": {
        "^MBLK-[0-9]{3}-[A-Z0-9-]+$": {
          "$ref": "#/$defs/block"
        }
      },
      "additionalProperties": false
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "systemId": {
      "type": "string",
      "pattern": "^GSI-[0-9]{2}\\.[0-9]{2}$"
    },
    "loopId": {
      "type": "string",
      "pattern": "^LOOP-[0-9]{3}-[A-Z0-9-]+$"
    },
    "citation": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      },
      "minItems": 1
    },
    "nativeAnchor": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "object",
          "required": [
            "symbol",
            "address",
            "evidence"
          ],
          "properties": {
            "symbol": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "address": {
              "type": "string",
              "pattern": "^0x[0-9A-Fa-f]{4,8}$"
            },
            "evidence": {
              "$ref": "#/$defs/citation"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "rustSurface": {
      "type": "object",
      "required": [
        "path",
        "coverage",
        "observed_at_commit"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(src|tests)/.+"
        },
        "symbol": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "coverage": {
          "enum": [
            "representative",
            "exhaustive"
          ]
        },
        "observed_at_commit": {
          "$ref": "#/$defs/commit"
        }
      },
      "additionalProperties": false
    },
    "activation": {
      "type": "object",
      "required": [
        "mode",
        "stock_status",
        "trigger",
        "stock_fixture",
        "guards"
      ],
      "properties": {
        "mode": {
          "enum": [
            "command",
            "event",
            "lifecycle",
            "scheduled",
            "state-transition",
            "presentation"
          ]
        },
        "stock_status": {
          "enum": [
            "STOCK_ACTIVE",
            "MODE_ACTIVE",
            "CONTENT_CONDITIONAL",
            "UNCHECKED"
          ]
        },
        "trigger": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stock_fixture": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "guards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": [
        "name",
        "detail"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "producer_systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/systemId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "external_source": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "anyOf": [
        {
          "required": [
            "producer_systems"
          ]
        },
        {
          "required": [
            "external_source"
          ]
        }
      ],
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": [
        "aspect",
        "owner",
        "detail"
      ],
      "properties": {
        "aspect": {
          "enum": [
            "command",
            "state",
            "algorithm",
            "lifecycle",
            "ordering",
            "presentation",
            "audio",
            "rng",
            "persistence"
          ]
        },
        "owner": {
          "$ref": "#/$defs/systemId"
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "order",
        "system",
        "action"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "system": {
          "$ref": "#/$defs/systemId"
        },
        "action": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "name",
        "detail"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "consumer_systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/systemId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "player_visible": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "required": [
            "consumer_systems"
          ]
        },
        {
          "properties": {
            "player_visible": {
              "const": true
            }
          },
          "required": [
            "player_visible"
          ]
        }
      ],
      "additionalProperties": false
    },
    "criticalSemantic": {
      "type": "object",
      "required": [
        "kind",
        "status",
        "basis",
        "detail"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ordering",
            "authority",
            "algorithm",
            "lifecycle",
            "rng",
            "timer",
            "same-tick",
            "state-transition",
            "presentation",
            "audio"
          ]
        },
        "status": {
          "enum": [
            "VERIFIED",
            "CONFIRMED",
            "INFERRED",
            "UNCHECKED"
          ]
        },
        "basis": {
          "enum": [
            "native-binary",
            "retail-data",
            "rust-source",
            "mixed",
            "unverified"
          ]
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "VERIFIED",
                  "CONFIRMED",
                  "INFERRED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "CONFIRMED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "basis": {
                "const": "rust-source"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "VERIFIED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "basis": {
                "enum": [
                  "native-binary",
                  "retail-data",
                  "mixed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNCHECKED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "basis": {
                "const": "unverified"
              }
            }
          }
        }
      ]
    },
    "loopMembership": {
      "type": "object",
      "required": [
        "loop",
        "stage_orders"
      ],
      "properties": {
        "loop": {
          "$ref": "#/$defs/loopId"
        },
        "stage_orders": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "openQuestion": {
      "type": "object",
      "required": [
        "detail",
        "impact"
      ],
      "properties": {
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "impact": {
          "enum": [
            "MILESTONE-BLOCKING",
            "COMPOUNDING",
            "EXACTIFICATION-RESIDUAL",
            "UNKNOWN-RISK"
          ]
        }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": [
        "name",
        "owner",
        "participants",
        "contract",
        "activation",
        "inputs",
        "authority",
        "steps",
        "outputs",
        "critical_semantics",
        "loop_memberships",
        "native_anchors",
        "rust_surfaces",
        "research_query",
        "evidence",
        "open_questions"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "owner": {
          "$ref": "#/$defs/systemId"
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/systemId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "contract": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "activation": {
          "$ref": "#/$defs/activation"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input"
          },
          "minItems": 1
        },
        "authority": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authority"
          },
          "minItems": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          },
          "minItems": 1
        },
        "critical_semantics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criticalSemantic"
          },
          "minItems": 1
        },
        "loop_memberships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loopMembership"
          },
          "minItems": 1
        },
        "native_anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nativeAnchor"
          }
        },
        "rust_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rustSurface"
          }
        },
        "research_query": {
          "allOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "maxLength": 1000
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/openQuestion"
          }
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "plane",
        "kind",
        "from",
        "to",
        "detail"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MBEDGE-[0-9]{4}-[A-Z0-9-]+$"
        },
        "plane": {
          "enum": [
            "native",
            "rust",
            "oracle",
            "routing"
          ]
        },
        "kind": {
          "enum": [
            "requires",
            "ordered_before",
            "handoff_to",
            "emits_to",
            "consumes",
            "gated_by",
            "presents",
            "plays_audio"
          ]
        },
        "from": {
          "type": "string",
          "pattern": "^MBLK-[0-9]{3}-[A-Z0-9-]+$"
        },
        "to": {
          "type": "string",
          "pattern": "^MBLK-[0-9]{3}-[A-Z0-9-]+$"
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "context": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "loop": {
          "$ref": "#/$defs/loopId"
        },
        "observed_at_commit": {
          "$ref": "#/$defs/commit"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "plane": {
                "const": "native"
              }
            },
            "required": [
              "plane"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "plane": {
                "const": "rust"
              }
            },
            "required": [
              "plane"
            ]
          },
          "then": {
            "required": [
              "observed_at_commit",
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ordered_before"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "context"
            ]
          }
        }
      ]
    }
  }
}
