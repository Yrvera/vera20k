{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vera20k://system-map/topology.v2",
  "title": "VERA20k System Map v2 reviewed topology",
  "type": "object",
  "required": [
    "schema_version",
    "observed_at_commit",
    "id_policy",
    "legacy_slice_aliases",
    "systems",
    "services",
    "edges",
    "loops",
    "coupled_sets"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "observed_at_commit": {
      "$ref": "#/$defs/commit"
    },
    "id_policy": {
      "$ref": "#/$defs/idPolicy"
    },
    "legacy_slice_aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legacyAlias"
      }
    },
    "systems": {
      "type": "object",
      "patternProperties": {
        "^GSI-[0-9]{2}\\.[0-9]{2}$": {
          "$ref": "#/$defs/systemAnnotation"
        }
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "$ref": "#/$defs/service"
        }
      },
      "additionalProperties": false
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "loops": {
      "type": "object",
      "patternProperties": {
        "^LOOP-[0-9]{3}-[A-Z0-9-]+$": {
          "$ref": "#/$defs/loop"
        }
      },
      "additionalProperties": false
    },
    "coupled_sets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coupledSet"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "canonicalSystem": {
      "type": "string",
      "pattern": "^GSI-[0-9]{2}\\.[0-9]{2}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "citation": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      },
      "minItems": 1
    },
    "idPolicy": {
      "type": "object",
      "required": [
        "canonical_system_pattern",
        "slice_pattern",
        "loop_pattern",
        "edge_pattern",
        "rule"
      ],
      "properties": {
        "canonical_system_pattern": {
          "const": "^GSI-[0-9]{2}\\.[0-9]{2}$"
        },
        "slice_pattern": {
          "const": "^SLICE-[0-9]{8}-[A-Z0-9-]+$"
        },
        "loop_pattern": {
          "const": "^LOOP-[0-9]{3}-[A-Z0-9-]+$"
        },
        "edge_pattern": {
          "const": "^EDGE-[0-9]{4}-[A-Z0-9-]+$"
        },
        "rule": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "legacyAlias": {
      "type": "object",
      "required": [
        "legacy_id",
        "slice_id",
        "canonical_systems",
        "reason",
        "evidence"
      ],
      "properties": {
        "legacy_id": {
          "type": "string",
          "pattern": "^GSI-[0-9]{2}\\.[0-9]{2}[A-Z]$"
        },
        "slice_id": {
          "type": "string",
          "pattern": "^SLICE-[0-9]{8}-[A-Z0-9-]+$"
        },
        "canonical_systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonicalSystem"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    },
    "nativeAnchor": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "object",
          "required": [
            "symbol",
            "address",
            "evidence"
          ],
          "properties": {
            "symbol": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "address": {
              "type": "string",
              "pattern": "^0x[0-9A-Fa-f]{4,8}$"
            },
            "evidence": {
              "$ref": "#/$defs/citation"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "rustSurface": {
      "type": "object",
      "required": [
        "path",
        "coverage",
        "observed_at_commit"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(src|tests)/.+"
        },
        "symbol": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "coverage": {
          "enum": [
            "representative",
            "exhaustive"
          ]
        },
        "observed_at_commit": {
          "$ref": "#/$defs/commit"
        }
      },
      "additionalProperties": false
    },
    "systemAnnotation": {
      "type": "object",
      "properties": {
        "native_anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nativeAnchor"
          }
        },
        "rust_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rustSurface"
          }
        },
        "rust_surface_coverage": {
          "enum": [
            "representative",
            "exhaustive"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "gsi_ids",
        "roles",
        "detail",
        "evidence"
      ],
      "properties": {
        "gsi_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonicalSystem"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "consumes",
              "drives",
              "handoff",
              "orders",
              "owns_algorithm",
              "owns_iteration",
              "owns_lifecycle",
              "owns_state",
              "presents",
              "provides"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "plane",
        "kind",
        "from",
        "to",
        "detail"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EDGE-[0-9]{4}-[A-Z0-9-]+$"
        },
        "plane": {
          "enum": [
            "native",
            "rust",
            "oracle",
            "routing"
          ]
        },
        "kind": {
          "enum": [
            "requires",
            "owns_state",
            "owns_algorithm",
            "reads",
            "writes",
            "ordered_before",
            "emits",
            "emits_to",
            "consumes",
            "lifecycle_handoff",
            "handoff_to",
            "renders",
            "presents",
            "plays_audio",
            "drives",
            "gated_by",
            "loop_requires"
          ]
        },
        "from": {
          "$ref": "#/$defs/canonicalSystem"
        },
        "to": {
          "$ref": "#/$defs/canonicalSystem"
        },
        "detail": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "context": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "state": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "loop": {
          "type": "string",
          "pattern": "^LOOP-[0-9]{3}-[A-Z0-9-]+$"
        },
        "observed_at_commit": {
          "$ref": "#/$defs/commit"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "plane": {
                "const": "native"
              }
            },
            "required": [
              "plane"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "plane": {
                "const": "rust"
              }
            },
            "required": [
              "plane"
            ]
          },
          "then": {
            "required": [
              "observed_at_commit",
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ordered_before"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "context"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "owns_state"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "state"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "loop_requires"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "loop"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "loopStage": {
      "type": "object",
      "required": [
        "order",
        "system",
        "action"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "system": {
          "$ref": "#/$defs/canonicalSystem"
        },
        "action": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rust_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rustSurface"
          }
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "method",
        "command",
        "result",
        "artifacts"
      ],
      "properties": {
        "method": {
          "enum": [
            "exhaustive_proof",
            "native_executable"
          ]
        },
        "command": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "result": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/oracleArtifact"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "oracleArtifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      },
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "required": [
        "status",
        "gate"
      ],
      "properties": {
        "status": {
          "enum": [
            "BLOCKED",
            "BLOCKED_EXTERNAL",
            "TRACE_MATCHED",
            "UNCHECKED",
            "UNVERIFIED",
            "VERIFIED"
          ]
        },
        "gate": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "TRACE_MATCHED",
                  "VERIFIED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "verification"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "loop": {
      "type": "object",
      "required": [
        "name",
        "owner",
        "stock_fixture",
        "player_visible_result",
        "native_entrypoints",
        "rust_touchpoints",
        "stages",
        "oracle",
        "evidence"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "owner": {
          "$ref": "#/$defs/canonicalSystem"
        },
        "stock_fixture": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "player_visible_result": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ordering_note": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "native_entrypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nativeAnchor"
          },
          "minItems": 1
        },
        "rust_touchpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rustSurface"
          },
          "minItems": 1
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loopStage"
          },
          "minItems": 2
        },
        "oracle": {
          "$ref": "#/$defs/oracle"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    },
    "coupledSet": {
      "type": "object",
      "required": [
        "id",
        "reason",
        "systems",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonicalSystem"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    }
  }
}
