{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vera20k://system-map/registry.v2",
  "title": "VERA20k System Map v2 normalized registry",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_rust_snapshot",
    "families",
    "service_catalog",
    "systems"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "baseline_rust_snapshot": {
      "$ref": "#/$defs/commit"
    },
    "families": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^GSI-[0-9]{2}$": {
          "$ref": "#/$defs/family"
        }
      },
      "additionalProperties": false
    },
    "service_catalog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/serviceSlug"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "systems": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^GSI-[0-9]{2}\\.[0-9]{2}$": {
          "$ref": "#/$defs/system"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "serviceSlug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "family": {
      "type": "object",
      "required": [
        "name",
        "systems"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "systems": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^GSI-[0-9]{2}\\.[0-9]{2}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "baselineStatus": {
      "type": "object",
      "required": [
        "activity",
        "basis",
        "inventory_evidence",
        "native_evidence",
        "parity",
        "rust_implementation"
      ],
      "properties": {
        "activity": {
          "enum": [
            "STOCK_ACTIVE",
            "MODE_ACTIVE",
            "CONTENT_CONDITIONAL",
            "COMPILED_INACTIVE",
            "UNKNOWN",
            "GROUP_NODE"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "inventory_evidence": {
          "enum": [
            "DISCOVERED",
            "BOUNDED",
            "EXHAUSTIVE_SLICE",
            "GROUP_NODE"
          ]
        },
        "native_evidence": {
          "enum": [
            "UNCHECKED",
            "ANCHORED",
            "CONTRACTED",
            "NATIVE_ORACLE",
            "N/A"
          ]
        },
        "parity": {
          "enum": [
            "UNCHECKED",
            "DRIFT",
            "TRACE_MATCHED",
            "VERIFIED",
            "N/A"
          ]
        },
        "rust_implementation": {
          "enum": [
            "ABSENT",
            "SCAFFOLD",
            "PARTIAL",
            "PRESENT",
            "COMPLETE_FOR_CONTRACT",
            "N/A"
          ]
        }
      },
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "required": [
        "baseline_status",
        "discovery_scope",
        "family",
        "family_name",
        "name",
        "source_line"
      ],
      "properties": {
        "baseline_status": {
          "$ref": "#/$defs/baselineStatus"
        },
        "discovery_scope": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "pattern": "^GSI-[0-9]{2}$"
        },
        "family_name": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source_line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
