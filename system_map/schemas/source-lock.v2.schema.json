{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vera20k://system-map/source-lock.v2",
  "title": "VERA20k System Map v2 source lock",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_rust_snapshot",
    "registry_sha256",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "baseline_rust_snapshot": {
      "$ref": "#/$defs/commit"
    },
    "registry_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sources": {
      "type": "object",
      "required": [
        "core_services",
        "inventory",
        "status_matrix"
      ],
      "properties": {
        "core_services": {
          "$ref": "#/$defs/source"
        },
        "inventory": {
          "$ref": "#/$defs/source"
        },
        "status_matrix": {
          "$ref": "#/$defs/source"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/research/.+\\.md$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
