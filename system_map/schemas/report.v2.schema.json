{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vera20k://system-map/report.v2",
  "title": "VERA20k System Map v2 merged report",
  "type": "object",
  "required": [
    "schema_version",
    "observed_at_commit",
    "provenance",
    "source_baseline",
    "repository",
    "id_policy",
    "legacy_slice_aliases",
    "systems",
    "services",
    "edges",
    "loops",
    "coupled_sets",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "observed_at_commit": {
      "$ref": "#/$defs/commit"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "source_baseline": {
      "type": "object",
      "required": [
        "baseline_rust_snapshot",
        "source_lock"
      ],
      "properties": {
        "baseline_rust_snapshot": {
          "$ref": "#/$defs/commit"
        },
        "source_lock": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "id_policy": {
      "type": "object"
    },
    "legacy_slice_aliases": {
      "type": "array"
    },
    "systems": {
      "type": "object",
      "patternProperties": {
        "^GSI-[0-9]{2}\\.[0-9]{2}$": {
          "$ref": "#/$defs/system"
        }
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object"
    },
    "edges": {
      "type": "array"
    },
    "loops": {
      "type": "object"
    },
    "coupled_sets": {
      "type": "array"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "pathList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "generator",
        "inputs"
      ],
      "properties": {
        "generator": {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "const": "vera20k-system-map"
            },
            "version": {
              "const": "1.0.0"
            }
          },
          "additionalProperties": false
        },
        "inputs": {
          "type": "object",
          "required": [
            "registry",
            "source_lock",
            "topology"
          ],
          "properties": {
            "registry": {
              "allOf": [
                {
                  "$ref": "#/$defs/inputArtifact"
                },
                {
                  "properties": {
                    "path": {
                      "const": "system_map/registry.v2.json"
                    }
                  }
                }
              ]
            },
            "source_lock": {
              "allOf": [
                {
                  "$ref": "#/$defs/inputArtifact"
                },
                {
                  "properties": {
                    "path": {
                      "const": "system_map/source-lock.v2.json"
                    }
                  }
                }
              ]
            },
            "topology": {
              "allOf": [
                {
                  "$ref": "#/$defs/inputArtifact"
                },
                {
                  "properties": {
                    "path": {
                      "const": "system_map/topology.v2.json"
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "inputArtifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": [
        "branch",
        "dirty_paths",
        "head"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "dirty_paths": {
          "$ref": "#/$defs/pathList"
        },
        "head": {
          "oneOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "const": "UNAVAILABLE"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "freshnessResult": {
      "type": "object",
      "required": [
        "changed_paths",
        "dirty_paths",
        "missing_paths",
        "observed_at_commits",
        "paths",
        "reasons",
        "state"
      ],
      "properties": {
        "changed_paths": {
          "$ref": "#/$defs/pathList"
        },
        "dirty_paths": {
          "$ref": "#/$defs/pathList"
        },
        "missing_paths": {
          "$ref": "#/$defs/pathList"
        },
        "observed_at_commits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commit"
          }
        },
        "paths": {
          "$ref": "#/$defs/pathList"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "state": {
          "enum": [
            "UNMAPPED",
            "MISSING",
            "DIVERGED",
            "STALE",
            "UNRESOLVED",
            "FRESH"
          ]
        }
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "required": [
        "baseline_status_freshness",
        "rust_mapping_freshness"
      ],
      "properties": {
        "baseline_status_freshness": {
          "$ref": "#/$defs/freshnessResult"
        },
        "rust_mapping_freshness": {
          "$ref": "#/$defs/freshnessResult"
        }
      },
      "additionalProperties": false
    },
    "routingMetrics": {
      "type": "object",
      "required": [
        "incoming_edges",
        "loop_memberships",
        "loop_required_by",
        "loop_requires",
        "outgoing_edges",
        "owned_loops",
        "required_by",
        "requires",
        "service_memberships"
      ],
      "properties": {
        "incoming_edges": {
          "type": "integer",
          "minimum": 0
        },
        "loop_memberships": {
          "type": "integer",
          "minimum": 0
        },
        "loop_required_by": {
          "type": "integer",
          "minimum": 0
        },
        "loop_requires": {
          "type": "integer",
          "minimum": 0
        },
        "outgoing_edges": {
          "type": "integer",
          "minimum": 0
        },
        "owned_loops": {
          "type": "integer",
          "minimum": 0
        },
        "required_by": {
          "type": "integer",
          "minimum": 0
        },
        "requires": {
          "type": "integer",
          "minimum": 0
        },
        "service_memberships": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "required": [
        "baseline_status",
        "discovery_scope",
        "family",
        "family_name",
        "freshness",
        "name",
        "routing_metrics",
        "source_line",
        "topology"
      ],
      "properties": {
        "baseline_status": {
          "type": "object"
        },
        "discovery_scope": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "pattern": "^GSI-[0-9]{2}$"
        },
        "family_name": {
          "type": "string",
          "minLength": 1
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "routing_metrics": {
          "$ref": "#/$defs/routingMetrics"
        },
        "source_line": {
          "type": "integer",
          "minimum": 1
        },
        "topology": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "field",
        "message",
        "path",
        "record_id",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "record_id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
